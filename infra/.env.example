# Secretos locales del perfil `cti` (OpenCTI). Copiar a infra/.env (ignorado por git) y
# rellenar, o generarlo con:  python3 ../scripts/gen_env_opencti.py
OPENCTI_ADMIN_EMAIL=admin@tfg.local
OPENCTI_ADMIN_PASSWORD=
OPENCTI_ADMIN_TOKEN=            # UUIDv4
OPENCTI_ENCRYPTION_KEY=         # 32 bytes en base64
OPENCTI_HEALTHCHECK_ACCESS_KEY=
MINIO_ROOT_USER=opencti
MINIO_ROOT_PASSWORD=
RABBITMQ_DEFAULT_USER=opencti
RABBITMQ_DEFAULT_PASS=
CONNECTOR_MITRE_ID=             # UUIDv4 (uno distinto por conector)
CONNECTOR_EXPORT_FILE_STIX_ID=
CONNECTOR_IMPORT_FILE_STIX_ID=
CONNECTOR_IMPORT_DOCUMENT_ID=
