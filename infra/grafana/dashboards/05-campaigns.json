    {
      "type": "table",
      "title": "Por dataset: campañas esperadas (verdad) y detectadas",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-tfg"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT v.dataset_id AS dataset, v.origen, v.p1_esperado AS P1_esp, countIf(c.pattern_id = 'P1') AS P1_det, v.p2_esperado AS P2_esp, countIf(c.pattern_id = 'P2') AS P2_det, v.p3_esperado AS P3_esp, countIf(c.pattern_id = 'P3') AS P3_det, multiIf((v.p1_esperado AND countIf(c.pattern_id = 'P1') = 0) OR (v.p2_esperado AND countIf(c.pattern_id = 'P2') = 0) OR (v.p3_esperado AND countIf(c.pattern_id = 'P3') = 0), 'falta alguna', (NOT v.p1_esperado AND countIf(c.pattern_id = 'P1') > 0) OR (NOT v.p2_esperado AND countIf(c.pattern_id = 'P2') > 0) OR (NOT v.p3_esperado AND countIf(c.pattern_id = 'P3') > 0), 'sobra alguna', 'cuadra') AS lectura FROM (SELECT * FROM tfg.verdad_datasets FINAL WHERE dataset_id IN (${dataset:singlequote})) AS v LEFT JOIN (SELECT * FROM tfg.campaigns FINAL WHERE dataset_id IN (${dataset:singlequote})) AS c ON c.dataset_id = v.dataset_id GROUP BY v.dataset_id, v.origen, v.p1_esperado, v.p2_esperado, v.p3_esperado HAVING P1_esp + P2_esp + P3_esp + P1_det + P2_det + P3_det > 0 ORDER BY lectura = 'cuadra', lectura, dataset",
          "format": 1,
          "queryType": "table",
          "editorType": "sql",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-tfg"
          }
        }
      ],
      "description": "«sobra alguna» son candidatas a falso positivo; «falta alguna», a falso negativo. Hay que revisarlas a mano: en F3, parte de las «sobrantes» eran ataques reales que la ficha del dataset no listaba.",
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": []
