    {
      "type": "barchart",
      "title": "Señales precalculadas en la normalización",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-tfg"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT s.1 AS senal, s.2 AS n FROM (SELECT arrayJoin([('Acceso a LSASS', countIf(signal_lsass_access)), ('Acceso sospechoso', countIf(signal_suspicious_access)), ('DLL de volcado', countIf(signal_dump_module)), ('Volcado a disco', countIf(signal_dump_file)), ('Borrado de logs', countIf(signal_log_cleared)), ('Logon remoto', countIf(signal_remote_logon))]) AS s FROM tfg.events FINAL WHERE dataset_id IN (${dataset:singlequote})) ORDER BY n DESC",
          "format": 1,
          "queryType": "table",
          "editorType": "sql",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-tfg"
