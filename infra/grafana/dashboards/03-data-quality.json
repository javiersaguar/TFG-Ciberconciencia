    "from": "now-8y",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "origen",
        "label": "Origen",
        "type": "query",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "clickhouse-tfg"
        },
        "multi": true,
        "includeAll": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 1,
        "sort": 1,
        "query": "SELECT DISTINCT origen FROM tfg.verdad_datasets FINAL ORDER BY origen",
        "definition": "SELECT DISTINCT origen FROM tfg.verdad_datasets FINAL ORDER BY origen"
      },
      {
        "name": "dataset",
        "label": "Dataset",
        "type": "query",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "clickhouse-tfg"
        },
        "multi": true,
        "includeAll": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1,
        "query": "SELECT dataset_id FROM tfg.verdad_datasets FINAL WHERE origen IN (${origen:singlequote}) ORDER BY dataset_id",
        "definition": "SELECT dataset_id FROM tfg.verdad_datasets FINAL WHERE origen IN (${origen:singlequote}) ORDER BY dataset_id"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Cobertura de normalización (medida en el bus de eventos)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "gauge",
      "title": "Cobertura OCSF global (%)",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(redpanda_kafka_max_offset{redpanda_topic=~\"norm\\\\..*events\"}) / (sum(redpanda_kafka_max_offset{redpanda_topic=~\"norm\\\\..*events\"}) + sum(redpanda_kafka_max_offset{redpanda_topic=~\"dlq\\\\..*normalize\"}))",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        }
      ],
      "description": "Eventos normalizados / (normalizados + rechazados a la DLQ), sumando todos los topics del bus. Los rechazos son tipos de evento sin mapeador, siempre con su motivo.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 90
              },
              {
                "color": "green",
                "value": 98
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Mensajes por topic de normalización y de rechazo",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 18,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (redpanda_topic) (redpanda_kafka_max_offset{redpanda_topic=~\"(norm|dlq)\\\\..*(events|normalize)\"})",
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        }
      ],
      "description": "Cada pasada de carga (F3 y las de FA) tiene sus propios topics: así se ve la cobertura de cada una.",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "redpanda_topic": "topic",
              "Value": "mensajes"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "topic"
          }
        ]
      }
    },
    {
      "type": "row",
      "title": "Datasets (filtros: origen y dataset)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Datasets cargados, con su verdad conocida y resultados",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-tfg"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT v.dataset_id AS dataset, v.origen, v.titulo, v.verdad, e.eventos, e.hosts, e.primer_evento, e.ultimo_evento, a.alertas, c.campanas FROM (SELECT * FROM tfg.verdad_datasets FINAL WHERE dataset_id IN (${dataset:singlequote})) AS v LEFT JOIN (SELECT dataset_id, count() AS eventos, uniqExact(device_hostname) AS hosts, min(time) AS primer_evento, max(time) AS ultimo_evento FROM tfg.events FINAL WHERE dataset_id IN (${dataset:singlequote}) GROUP BY dataset_id) AS e ON e.dataset_id = v.dataset_id LEFT JOIN (SELECT dataset_id, count() AS alertas FROM tfg.alerts FINAL WHERE dataset_id IN (${dataset:singlequote}) GROUP BY dataset_id) AS a ON a.dataset_id = v.dataset_id LEFT JOIN (SELECT dataset_id, count() AS campanas FROM tfg.campaigns FINAL WHERE dataset_id IN (${dataset:singlequote}) GROUP BY dataset_id) AS c ON c.dataset_id = v.dataset_id ORDER BY v.origen, e.eventos DESC SETTINGS join_use_nulls = 1",
          "format": 1,
          "queryType": "table",
          "editorType": "sql",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-tfg"
          }
        }
      ],
      "description": "Sin eventos puede significar dos cosas: los atómicos de OTRF se procesan sin volcar sus eventos a tfg.events (solo alertas y campañas, por espacio), y el segundo host de COMISET solo trae canales sin mapeador.",
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": []
      }
    },
